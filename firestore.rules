rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      // Check if user has 'admin' or 'superadmin' role in custom claims or user profile
      return request.auth != null && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in ['admin', 'superadmin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }

    function isEnrolled(courseId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrolledCourses/$(courseId)) ||
        isAdmin()
      );
    }

    // Helper: Check if user is a teacher
    function isTeacher() {
      return request.auth != null && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'teacher') ||
        (request.auth.token != null && 'isTeacher' in request.auth.token && request.auth.token.isTeacher == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeacher == true
        ))
      );
    }

    // Helper: Check if user is the community owner (teacher)
    function isCommunityOwner(teacherId) {
      return request.auth != null && teacherId == request.auth.uid;
    }

    // Helper: Check if user is a community member (admin, teacher, or enrolled student)
    function isCommunityMember(courseIds) {
      return request.auth != null && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'enrolledCourses' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny(courseIds)
        )
      );
    }

    // Collection Group Rules (required for collectionGroup queries in admin panel)
    match /{path=**}/live_classes/{classId} {
      allow read: if request.auth != null && (isAdmin() || isTeacher());
    }

    match /{path=**}/batches/{batchId} {
      allow read: if request.auth != null && (isAdmin() || isTeacher());
    }

    match /{path=**}/lessons/{lessonId} {
      allow read: if request.auth != null && (isAdmin() || isTeacher());
    }

    // User profiles: Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
      
      // User's cart subcollection
      match /cart/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Progress subcollection
      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // Tests subcollection
      match /tests/{testId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Course Progress subcollection (new schema)
      match /courseProgress/{courseId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isTeacher());
        allow write: if request.auth != null && request.auth.uid == uid;
        
        match /lectures/{lectureId} {
          allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isTeacher());
          allow write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Legacy Batch Progress subcollection (backwards compatibility)
      match /batchProgress/{progressId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        
        match /lectures/{lectureId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // User course bookmarks
      match /courseBookmarks/{bookmarkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // User transactions subcollection (payment history)
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        // No update/delete to preserve transaction history
      }

      // User quiz stats (aggregate statistics)
      match /stats/{statId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isTeacher());
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // User quiz attempts (individual attempt records)
      match /quiz_attempts/{attemptId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isTeacher());
        allow create: if request.auth != null && request.auth.uid == uid;
        // No update/delete to preserve history
      }

      // User watch sessions (video viewing records)
      match /watch_sessions/{sessionId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isTeacher());
        allow create: if request.auth != null && request.auth.uid == uid;
        // No update/delete to preserve history
      }

      // User bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // User test attempts (test series completion tracking)
      match /test_attempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow read, write: if isAdmin();
      }

      // User enrolled courses
      match /enrolledCourses/{enrollmentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow read, write: if isAdmin();
      }

      // User purchased test series
      match /purchasedTestSeries/{tsId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow read, write: if isAdmin();
      }

      // User purchased e-books tracking
      match /purchasedEbooks/{ebookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow read, write: if isAdmin();
      }
    }

    // Config collection (payment settings, etc.)
    match /config/{configId} {
      // All authenticated users can read keyId for payment
      allow read: if request.auth != null;
      // Only admins can write config
      allow write: if isAdmin();

      // Promo codes subcollection
      match /{subcol}/{docId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // App Config collection (app version, update links, etc.)
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Courses: Public read if published, Auth read for all, Admin write
    match /courses/{courseId} {
      // Allow anyone to read published courses (for landing page)
      allow read: if resource.data.visibility == 'published';
      // Allow authenticated users to read any course (needed for enrollment fetch)
      allow read: if request.auth != null;
      allow write: if isAdmin();
      
      match /lessons/{lessonId} {
        // Allow enrolled users, admins or teachers to read lessons
        allow read: if isEnrolled(courseId) || isTeacher();
        allow write: if isAdmin() || isTeacher();

        // Comments: Enrolled users can read/write comments
        match /comments/{commentId} {
          allow read: if isEnrolled(courseId);
          allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);

          // Replies subcollection
          match /replies/{replyId} {
            allow read: if isEnrolled(courseId);
            allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
            allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);
          }
        }

        match /live_comments/{commentId} {
          allow read: if isEnrolled(courseId);
          allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);

          match /replies/{replyId} {
            allow read: if isEnrolled(courseId);
            allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
            allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);
          }
        }
      }

      match /notes/{noteId} {
        allow read: if isEnrolled(courseId);
        allow write: if isAdmin();
      }

      match /planner/{plannerId} {
        allow read: if isEnrolled(courseId);
        allow write: if isAdmin();
      }

      match /quizzes/{quizId} {
        allow read: if isEnrolled(courseId);
        allow write: if isAdmin();
      }

      match /live_classes/{classId} {
        allow read: if isEnrolled(courseId) || isTeacher();
        allow create, delete: if isAdmin() || isTeacher();
        allow update: if isAdmin() || isTeacher() || (
          isEnrolled(courseId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount'])
        );
      }

      match /dpps/{dppId} {
        allow read: if isEnrolled(courseId);
        allow write: if isAdmin();
      }

      // Lectures subcollection (for Study Module)
      match /lectures/{lectureId} {
        allow read: if isEnrolled(courseId);
        allow write: if isAdmin();
      }

      match /scheduler_rules/{ruleId} {
        allow read: if isEnrolled(courseId) || isTeacher();
        allow write: if isAdmin() || isTeacher();
      }

      // ─── Legacy Batch Subcollection Rules (backwards compatibility) ───
      // These rules allow old app versions to continue reading content
      // from the nested batch path: courses/{courseId}/batches/{batchId}/...
      // Once all users have updated to the new app, these can be removed.
      // TODO: Remove after 2026-09-01 (3 months post-migration)
      match /batches/{batchId} {
        allow read: if isEnrolled(courseId);
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if isEnrolled(courseId);
          allow write: if isAdmin();

          match /comments/{commentId} {
            allow read: if isEnrolled(courseId);
            allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
            allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);

            match /replies/{replyId} {
              allow read: if isEnrolled(courseId);
              allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
              allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);
            }
          }

          match /live_comments/{commentId} {
            allow read: if isEnrolled(courseId);
            allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
            allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);

            match /replies/{replyId} {
              allow read: if isEnrolled(courseId);
              allow create: if isEnrolled(courseId) && request.resource.data.userId == request.auth.uid;
              allow update, delete: if isAdmin() || (isEnrolled(courseId) && resource.data.userId == request.auth.uid);
            }
          }
        }

        match /notes/{noteId} {
          allow read: if isEnrolled(courseId);
          allow write: if isAdmin();
        }

        match /planner/{plannerId} {
          allow read: if isEnrolled(courseId);
          allow write: if isAdmin();
        }

        match /quizzes/{quizId} {
          allow read: if isEnrolled(courseId);
          allow write: if isAdmin();
        }

        match /live_classes/{classId} {
          allow read: if isEnrolled(courseId) || isTeacher();
          allow create, delete: if isAdmin() || isTeacher();
          allow update: if isAdmin() || isTeacher() || (
            isEnrolled(courseId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount'])
          );
        }

        match /dpps/{dppId} {
          allow read: if isEnrolled(courseId);
          allow write: if isAdmin();
        }
      }
    }

    // Purchases: User create own, Admin read/write
    match /purchases/{purchaseId} {
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Enrollments: Read own, Write only via Admin/Functions
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Only via Cloud Functions
    }

    // Feed: Public/Auth read, Admin write (except counter fields)
    match /feed/{feedId} {
      allow read: if request.auth != null;
      // Allow admins full write access
      allow create, delete: if isAdmin();
      // Allow admins to update anything, but allow auth users to update only counters
      allow update: if isAdmin() || (
        request.auth != null &&
        // Only allow updating likesCount and commentsCount
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );

      // Likes subcollection: Users can read all, create/delete their own
      match /likes/{likeId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && likeId == request.auth.uid;
      }

      // Comments subcollection: Users can read all, create their own, edit/delete own or admin
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      }

      // Answers subcollection (Answer writing feature): Users can read/write their own, Admins read all
      match /answers/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if isAdmin();
      }
    }

    // Audits: Admin read/write
    match /audits/{auditId} {
      allow read, write: if isAdmin();
    }
    
    // Admins collection (if used instead of custom claims)
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- STUDY MODULE RULES ---

    // Exams: Auth read, Admin write
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin Stats: Admin read/write
    match /admin_stats/{docId} {
      allow read, write: if isAdmin();
    }

    // Live Classes: Public/Auth read, Admin write
    match /live_classes/{classId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount'])
      );
    }

    // Mock Tests: Public/Auth read, Admin write
    match /mock_tests/{testId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Test Series: Public/Auth read, Admin write
    match /test_series/{testSeriesId} {
      allow read: if resource.data.visibility == 'published';
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /tests/{testId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Questions: Public/Auth read, Admin write
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Quiz Subjects (shared dropdown values): Auth read, Admin write
    match /quiz_subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global Quiz Pool (shared library for cross-batch/series sharing)
    // Admins can read/write; authenticated users can read (needed in admin import dialog)
    match /quizzes_pool/{quizId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Combination Packs: Public/Auth read, Admin write
    match /combination_packs/{packId} {
      allow read: if resource.data.isActive == true;
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // E-Books: Public/Auth read, Admin write
    match /ebooks/{ebookId} {
      allow read: if resource.data.isActive == true;
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    
    // Topic Nodes (Map Work): Public/Auth read, Admin write
    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Daily Practice: Public/Auth read, Admin write
    match /daily_practice/{practiceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Workbooks: User specific
    match /workbooks/{workbookId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Notifications: Authenticated users can read all, admins can write
    // Client-side filtering handles showing only relevant notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Free Live Classes: Public/Auth read, Admin write
    match /free_live_classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Allow comments on free classes
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);

        match /replies/{replyId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
        }
      }

      match /live_comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);

        match /replies/{replyId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
        }
      }
    }
    match /communities/{communityId} {
      allow read: if isCommunityMember(resource.data.courseIds) || isCommunityOwner(resource.data.teacherId);
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isCommunityOwner(resource.data.teacherId) || (
        (isCommunityMember(resource.data.courseIds) || isCommunityOwner(resource.data.teacherId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postCount', 'updatedAt'])
      );
      allow delete: if isAdmin();

      match /posts/{postId} {
        allow read: if isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                     isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId);
        allow create: if (isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                          isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                         request.resource.data.authorId == request.auth.uid;
        allow update: if isAdmin() || 
                         isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId) ||
                         ((isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                           isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                          resource.data.authorId == request.auth.uid) ||
                         ((isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                           isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['replyCount', 'isAnswered', 'updatedAt']));
        allow delete: if isAdmin() || 
                         isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId) ||
                         ((isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                           isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                          resource.data.authorId == request.auth.uid);

        match /replies/{replyId} {
          allow read: if isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                       isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId);
          allow create: if (isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                            isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                           request.resource.data.authorId == request.auth.uid;
          allow update: if isAdmin() || 
                           isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId) ||
                           ((isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                             isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                            resource.data.authorId == request.auth.uid);
          allow delete: if isAdmin() || 
                           isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId) ||
                           ((isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                             isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                            resource.data.authorId == request.auth.uid) ||
                           ((isCommunityMember(get(/databases/$(database)/documents/communities/$(communityId)).data.courseIds) || 
                             isCommunityOwner(get(/databases/$(database)/documents/communities/$(communityId)).data.teacherId)) && 
                            get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.authorId == request.auth.uid);
        }
      }
    }

    // Posters collection: Read for anyone, write only for Admin
    match /posters/{posterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
